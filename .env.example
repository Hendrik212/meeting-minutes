# ====================================================================
# Meetily Docker Configuration
# ====================================================================
# Copy this file to .env and configure your settings
# cp .env.example .env

# ====================================================================
# Domain & Network Configuration
# ====================================================================
# ⚠️  CRITICAL: Set DOMAIN to match your deployment URL
# This MUST match the domain users access in their browser
# Traefik uses this to route requests correctly
#
# Examples:
#   - Production: DOMAIN=meetily.yourdomain.com
#   - Local:      DOMAIN=localhost
#
# If DOMAIN doesn't match, you'll get 404 errors on API calls!
DOMAIN=localhost

# ACME Email for Let's Encrypt SSL (required if using built-in Traefik)
# ACME_EMAIL=your-email@example.com

# ====================================================================
# External Traefik Configuration (Advanced)
# ====================================================================
# If using an external Traefik instance, specify the network name:
# TRAEFIK_NETWORK=traefik
#
# Then edit docker-compose.yml networks section:
#   1. Uncomment "external: true"
#   2. Uncomment "name: ${TRAEFIK_NETWORK:-traefik}"
#   3. Comment out "driver: bridge"

# ====================================================================
# LLM Provider Configuration
# ====================================================================

# Default LLM Provider
# Options: openai, anthropic, groq, ollama, openrouter
DEFAULT_PROVIDER=openai

# Default Model for Summarization
DEFAULT_MODEL=gpt-4o

# ====================================================================
# OpenAI Configuration
# ====================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# Custom OpenAI Base URL (for OpenAI-compatible endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1
# Examples:
# - Local LM Studio: http://localhost:1234/v1
# - Text Generation WebUI: http://localhost:5000/v1
# - vLLM: http://localhost:8000/v1

# ====================================================================
# Other LLM Provider API Keys
# ====================================================================

# Anthropic Claude
ANTHROPIC_API_KEY=

# Groq
GROQ_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=

# ====================================================================
# Whisper Configuration (Speech-to-Text)
# ====================================================================

# Default Whisper Model
# Options: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en, large-v1, large-v2, large-v3, large-v3-turbo
# Recommendations:
#   - Development/Testing: base (fastest, good quality)
#   - Production (balanced): small or medium
#   - Production (best quality): large-v3 or large-v3-turbo
DEFAULT_WHISPER_MODEL=base

# Number of transcription threads
TRANSCRIPTION_THREADS=4

# ====================================================================
# Speaker Diarization Configuration
# ====================================================================

# Enable speaker diarization (who spoke when)
ENABLE_DIARIZATION=true

# HuggingFace Token (required for PyAnnote diarization models)
# Get your token from: https://huggingface.co/settings/tokens
# Then accept terms at: https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=hf_your_token_here

# ====================================================================
# GPU Configuration
# ====================================================================

# Enable GPU acceleration
ENABLE_GPU=true

# GPU Type: rocm (AMD), cuda (NVIDIA), or cpu
GPU_TYPE=rocm

# CUDA Visible Devices (NVIDIA only)
# Leave empty to use all GPUs, or specify GPU IDs (e.g., "0" or "0,1")
CUDA_VISIBLE_DEVICES=

# AMD GPU Configuration (ROCm)
# Override GPU architecture if auto-detection fails
# Examples: gfx900, gfx906, gfx908, gfx90a, gfx1030, gfx1100
# Check your GPU: rocminfo | grep gfx
# HSA_OVERRIDE_GFX_VERSION=10.3.0

# ROCm Version (default: 6.0)
ROCM_VERSION=6.0

# ====================================================================
# Application Settings
# ====================================================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum file upload size (in bytes)
# Default: 1073741824 (1GB)
MAX_UPLOAD_SIZE=1073741824

# Maximum number of worker processes
MAX_WORKERS=4

# ====================================================================
# Database Configuration
# ====================================================================
# Database is automatically created in Docker volume
# No configuration needed unless customizing paths

# ====================================================================
# Development Settings
# ====================================================================
# Uncomment for development mode
# NODE_ENV=development
# ENVIRONMENT=development

# ====================================================================
# Security Notes
# ====================================================================
# IMPORTANT:
# 1. Never commit .env file to version control
# 2. Use strong, unique API keys
# 3. Restrict CORS origins in production (edit backend code)
# 4. Enable HTTPS in production (configure Traefik)
# 5. Keep HuggingFace token private
# 6. Regularly rotate API keys
